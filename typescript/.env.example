SPOTIFY_CLIENT_ID=tu-client-id
SPOTIFY_CLIENT_SECRET=tu-client-secret

# Elige con qué corren TODAS las capas: "ollama" (local) o "bedrock" (AWS)
MODEL_PROVIDER=ollama

# Si MODEL_PROVIDER=ollama (debe estar descargado: ollama pull <modelo>)
MODEL_ID=llama3.1:8b
# Opcional: host de Ollama si no corre en el default
# OLLAMA_HOST=http://localhost:11434

# Si MODEL_PROVIDER=bedrock (requiere AWS CLI configurado con acceso a Bedrock)
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
AWS_REGION=us-east-1
